    <string name="phonetools_control_perm_a11y_title">Accessibility service (required)</string>
    <string name="phonetools_control_perm_a11y_detail">Reads screen layout, captures screenshots, and performs taps or text input during active tasks.</string>
    <string name="phonetools_control_perm_notif_title">Notification access</string>
    <string name="phonetools_control_perm_notif_detail">Reads incoming SMS or push verification codes in memory for automatic login.</string>
    <string name="phonetools_control_perm_overlay_title">Display over other apps</string>
    <string name="phonetools_control_perm_overlay_detail">Fallback floating overlay for task status, manual takeover, and emergency stop when accessibility overlay is unavailable.</string>
    <string name="phonetools_control_perm_post_notif_title">Notification permission</string>
    <string name="phonetools_control_perm_post_notif_detail">Shows high-priority heads-up banners with quick actions when remote tasks need your help.</string>
    <string name="phonetools_control_open_settings">Open settings</string>
    <string name="phonetools_control_bg_notice">Allow unrestricted battery use so the Hub connection stays active while switching to other apps.</string>
    <string name="phonetools_control_bg_action">Battery settings</string>
    <string name="phonetools_control_gate_otp_title">Allow notification OTP auto-login</string>
    <string name="phonetools_control_gate_otp_detail">Reads and fills SMS or notification verification codes while redacting raw codes from logs and replies. When off, login verification pauses on this phone.</string>
    <string name="phonetools_control_gate_payment_title">Block real payment &amp; transfer confirmations</string>
    <string name="phonetools_control_gate_payment_detail">Pauses and hands control to this phone before tapping payment or transfer confirmations (cannot be bypassed remotely). Turn off to allow payment taps.</string>
    <string name="phonetools_control_safety_footnote">Biometric prompts and graphic or slider CAPTCHAs always pause for manual completion on this phone.</string>
