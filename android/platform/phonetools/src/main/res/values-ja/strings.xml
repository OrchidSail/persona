    <string name="phonetools_control_section_title">リモート操作</string>
    <string name="phonetools_control_title">リモート画面操作</string>
    <string name="phonetools_control_subtitle">既定ではオフです。認可された Hub 拡張機能のみがペアリング済み接続経由で操作でき、オフまたは待機時のバックグラウンド負荷はゼロです。</string>
    <string name="phonetools_control_status_off">オフ</string>
