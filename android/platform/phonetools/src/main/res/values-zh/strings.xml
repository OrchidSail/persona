    <string name="phonetools_control_a11y_label">Persona 远程屏幕操控</string>
    <string name="phonetools_control_a11y_description">仅在手动开启远程屏幕操控后，允许已授权的 Persona Hub 扩展读取页面结构并执行点击或输入操作。</string>
    <string name="phonetools_control_notif_label">Persona 验证码通知读取</string>
    <string name="phonetools_control_perm_a11y_title">无障碍服务（必选）</string>
    <string name="phonetools_control_perm_a11y_detail">在执行任务时读取界面结构、按需截屏并执行点击或输入。</string>
    <string name="phonetools_control_perm_notif_title">通知读取权限</string>
    <string name="phonetools_control_perm_notif_detail">在内存中临时读取短信或应用通知验证码以完成自动登录。</string>
    <string name="phonetools_control_perm_overlay_title">悬浮窗权限</string>
    <string name="phonetools_control_perm_overlay_detail">用于显示任务进度、人工接管与急停按钮；未授予时将在无障碍开启后自动降级。</string>
    <string name="phonetools_control_open_settings">前往设置</string>
    <string name="phonetools_control_bg_notice">建议允许后台不受电池优化限制，避免切换到其他应用时断开与 Hub 的连接。</string>
    <string name="phonetools_control_bg_action">后台保活设置</string>
    <string name="phonetools_control_gate_otp_title">允许通知验证码自动登录</string>
    <string name="phonetools_control_gate_otp_detail">自动读取并填入短信或通知验证码，原始验证码始终从日志与回复中脱敏；关闭后登录验证码步骤将暂停等待手机端操作。</string>
    <string name="phonetools_control_gate_payment_title">拦截真实付款与转账确认</string>
    <string name="phonetools_control_gate_payment_detail">遇到支付、转账或收银台确认按钮时强制暂停并弹出悬浮窗交由手机本人操作（不可远程绕过）；关闭后将放行支付点击。</string>
    <string name="phonetools_control_safety_footnote">生物识别（指纹/面容）与图形滑块验证码始终在手机端人工完成；禁止 URI Scheme 深度链接跳转。</string>
